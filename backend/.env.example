# Environment Variables Example for Campus Life OS Backend

# Application Settings
PROJECT_NAME="Campus Life OS"
VERSION="1.0.0"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# Security & Tokens
# Generate a secure random 32+ character string in production (e.g. openssl rand -hex 32)
SECRET_KEY="bput-campus-life-hackathon-2026-production-key-replace-in-real-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite default for zero-config evaluation; PostgreSQL supported)
DATABASE_URL="sqlite:///./campus_life.db"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30

# Logging & Monitoring
LOG_LEVEL="INFO"
STRUCTURED_JSON_LOGS=True
